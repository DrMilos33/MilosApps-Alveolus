{
  "description": "ALVEOLUS task-size and local-only guards.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/user_prompt_rollover.ps1\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path ((git rev-parse --show-toplevel).Trim()) '.codex/hooks/user_prompt_rollover.ps1')\"",
            "timeout": 5,
            "statusMessage": "Checking ALVEOLUS task size"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_local_only.ps1\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path ((git rev-parse --show-toplevel).Trim()) '.codex/hooks/pre_tool_local_only.ps1')\"",
            "timeout": 5,
            "statusMessage": "Checking ALVEOLUS local-only policy"
          }
        ]
      }
    ]
  }
}
